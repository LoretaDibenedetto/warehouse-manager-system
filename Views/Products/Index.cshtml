@model List<WarehouseManager.Models.Product>

<div class="container mt-4">
    <h1>Products</h1>

    <a class="btn btn-primary mb-3" asp-controller="Products" asp-action="Create">Add new product</a>

    <form asp-action="Index" method="get" class="row g-2 mb-3">
        <div class="col-auto">
            <input type="text" name="searchString" class="form-control" placeholder="Search by name..." />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-secondary">Search</button>
        </div>
    </form>
    @if (Model.Count == 0)
    {
        <p class="alert alert-danger">Nessun prodotto trovato.</p>
        <a asp-controller="Products" asp-action="Index" class="btn btn-outline-secondary">Torna a tutti i prodotti</a>
    }
    else
    {
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Price</th>
                    <th>Category</th>
                    <th>Quantity</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var product in Model)
                {
                    <tr>
                        <td>@product.Name</td>
                        <td>@product.Price.ToString("C")</td>
                        <td>@product.Category</td>
                        <td>@product.Quantity</td>
                        <td>
                            <a asp-controller="Products" asp-action="Edit" asp-route-dbId="@product.Id" class="btn btn-sm btn-outline-primary">Modifica</a>
                            <form asp-controller="Products" asp-action="Delete" method="post" style="display:inline">
                                <input type="hidden" name="dbID" value="@product.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">Cancella</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>